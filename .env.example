# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to GitHub.

# The port the server will run on locally
PORT=5000

# Your MongoDB Atlas connection string (from Week 3 Day 2)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/iyunga_students?retryWrites=true&w=majority

# Comma-separated list of frontend origins allowed to call this API.
# Leave blank while testing locally by double-clicking index.html.
CLIENT_ORIGIN=

# ---------- Admin login ----------
# Pick any admin username you like:
ADMIN_USERNAME=admin

# Run: node scripts/hash-password.js YourChosenPassword
# then paste the printed hash below (never put the plain password here):
ADMIN_PASSWORD_HASH=

# Any long random string — used to sign login sessions.
# You can just mash the keyboard, it only needs to be long and secret.
JWT_SECRET=
